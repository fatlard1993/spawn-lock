{
	"schemaVersion": 1,
	"id": "spawn-lock-justfatlard",
	"version": "${version}",
	"name": "Spawn Lock",
	"description": "Holds a player at the spawn: newcomers until they say the password, and anyone an operator jails, for a while or until freed. Works for stock clients.",
	"authors": ["justfatlard"],
	"contact": {
		"homepage": "https://github.com/fatlard1993/spawn-lock",
		"sources": "https://github.com/fatlard1993/spawn-lock",
		"issues": "https://github.com/fatlard1993/spawn-lock/issues"
	},
	"license": "MIT",
	"icon": "assets/spawn-lock-justfatlard/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": ["justfatlard.spawn_lock.Main"]
	},
	"mixins": ["spawn-lock.mixins.json"],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"fabric-api": "${fabricApiVersion}",
		"pandorical": ">=1.3.9"
	}
}
